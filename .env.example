APP_NAME=nextup
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://nextup.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production: LOG_STACK=json (one JSON object per line, secrets redacted).
# LOG_JSON_TARGET=daily   # or "stderr" for container logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nextup
DB_USERNAME=nextup
DB_PASSWORD=nextup

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# External APIs (leave empty here; put real keys only in your local .env)
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Failed-job alert emails (leave empty to disable; failures are always logged)
ALERT_MAIL_TO=

VITE_APP_NAME="${APP_NAME}"

# --- Production only (set in ~/stack/nextup.env on the server, never here) ---
# See docs/deployment.md for the full list; docker/setup-env.sh writes the file.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://nextup.ojfdigital.co.uk
# DB_HOST=nextup-db            # the compose service names
# REDIS_HOST=nextup-redis
# INERTIA_SSR_URL=http://nextup-ssr:13714
# SESSION_SECURE_COOKIE=true
# LOG_STACK=json
# LOG_JSON_TARGET=stderr
