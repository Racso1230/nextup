# Append this block to the shared Caddyfile on the VPS, then reload Caddy
# (see docs/deployment.md). Caddy gets the HTTPS certificate on its own.
#
# Steam sign-in returns to /auth/steam/callback; nothing below blocks it.
nextup.ojfdigital.co.uk {
	encode zstd gzip

	header {
		# One day for now; raise it once HTTPS is proven stable.
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# Built assets have hashed file names, so they can be cached for a year.
	@build path /build/*
	header @build >Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy nextup:8080
}
